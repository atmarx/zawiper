# Your deployment, for make.  Copy site.example/ to site/ (git ignores it)
# and fill this in.  Make-style assignments: no quotes, no spaces around =.

# Where the bays dial: the hub's name, as in its certificate, and the link
# port.  `make bay` passes it to the installer.
HUB=zawiper.example.org:8461

# The hub host, as ssh reaches it.  `make hub-site` copies site/hub/ there.
HUB_HOST=hub-host
